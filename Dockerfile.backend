FROM node:20-slim AS runner

WORKDIR /app

# Önce sadece package.json dosyalarını kopyalıyoruz (Docker BuildKit önbelleklemesi için)
COPY package.json ./
COPY apps/backend/package.json ./apps/backend/
COPY apps/storefront/package.json ./apps/storefront/
COPY packages/ ./packages/

# 1. Proje yapısını bozmadan tüm ana bağımlılıkları kuruyoruz (npmmirror senkron gecikmesinde resmi npmjs'e yedekli)
RUN (npm config set registry https://registry.npmmirror.com && npm install --legacy-peer-deps --include=dev) || (npm config set registry https://registry.npmjs.org && npm install --legacy-peer-deps --include=dev)

# Kaynak kodlarını kopyalıyoruz
COPY . .
RUN rm -f package-lock.json

WORKDIR /app/apps/backend
ENV NODE_OPTIONS="--max-old-space-size=4096"

# 2. İnşaat işlemini güvenli kurulum aşamasında yapıyoruz
RUN npm run build

# 3. Medusa V2'nin "Admin panelini yanlış klasörde arama" hatasını (bug) çözmek için dosyaları kopyalıyoruz!
RUN cp -r .medusa/server/public ./public || true

EXPOSE 9000

# 4. Hatalı db komutlarını es geçip DOĞRUDAN sunucuyu (0.0.0.0 üzerinden) başlatıyoruz!
CMD ["npx", "medusa", "start", "-H", "0.0.0.0"]
